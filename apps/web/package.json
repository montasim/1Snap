    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
